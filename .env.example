# ============================================================
# .env.example — תבנית למשתני סביבה של הפרויקט
# ============================================================
# העתק את הקובץ הזה ל-.env ומלא את הערכים האמיתיים.
# הקובץ .env נמצא ב-.gitignore ולא יידחף ל-GitHub.
# ============================================================

# --- מפתחות API למודלים ---
ANTHROPIC_API_KEY=your-anthropic-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# --- GitHub ---
# Personal Access Token עם הרשאת repo
GITHUB_TOKEN=your-github-token-here

# --- שרת MCP (mcp-server/) ---
# חובה: Bearer token לגישה ל-/mcp (לפחות 16 תווים). ליצירה: openssl rand -hex 32
MCP_AUTH_TOKEN=generate-a-long-random-token-here
# full = קריאה + כתיבה + מחיקה + יצירת תמונות | readonly = כלי קריאה בלבד
MCP_MODE=full
# תקרת תמונות ליום (gpt-image-2 עולה כסף)
MAX_IMAGES_PER_DAY=20
# PORT=3000
# MCP_ALLOWED_ORIGINS=https://claude.ai,http://localhost:6274

# --- הגדרות כלליות ---
# סביבת ריצה: development | production
NODE_ENV=development
